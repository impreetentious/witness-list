{
  "name": "witness-list",
  "private": true,
  "type": "module",
  "version": "0.10.1",
  "description": "Witness List \u2014 a zero-knowledge proof workshop. Build a claim, prove it, try to cheat.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/impreetentious/witness-list.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "node scripts/serve-static.mjs out",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:perf": "playwright test tests/e2e/performance.spec.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:gates": "node scripts/check-gate-coverage.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "lint": "oxlint --deny-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "budget:bundle": "node scripts/bundle-budget.mjs",
    "budget:performance": "node scripts/performance-budget.mjs",
    "gates": "npm run budget:bundle && npm run budget:performance && npm run test:e2e",
    "check:version": "node scripts/check-version-coherence.mjs"
  },
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23",
      "sharp": "0.35.4"
    },
    "sharp": "0.35.4"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xyflow/react": "^12.11.2",
    "next": "16.3.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "fast-check": "^4.9.0",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
