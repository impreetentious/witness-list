{
  "name": "witness-list",
  "private": true,
  "type": "module",
  "version": "0.9.6",
  "description": "Witness List — a zero-knowledge proof workshop. Build a claim, prove it, try to cheat.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsMonarch04/witness-list.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "node scripts/serve-static.mjs out",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:perf": "playwright test tests/e2e/performance.spec.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:gates": "node scripts/check-gate-coverage.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "lint": "oxlint --deny-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "budget:bundle": "node scripts/bundle-budget.mjs",
    "budget:performance": "node scripts/performance-budget.mjs",
    "gates": "npm run budget:bundle && npm run budget:performance && npm run test:e2e",
    "check:version": "node scripts/check-version-coherence.mjs"
  },
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.6"
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/language": "^6.12.2",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.15",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@xyflow/react": "^12.10.1",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "fast-check": "^4.5.3",
    "oxlint": "^1.50.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.0",
    "vitest": "^4.0.18"
  }
}
