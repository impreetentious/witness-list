{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Resolved from the installed package, so the schema always matches the pinned oxlint.
  // Deliberate scope: correctness/suspicious with React, a11y, TypeScript, and
  // import checks. Avoid `all`; style/pedantic rules such as sort-keys and
  // explicit return types are disproportionate noise for this app.
  "categories": {
    "correctness": "deny",
    "suspicious": "deny"
  },
  "plugins": ["typescript", "import", "react", "jsx-a11y", "unicorn", "oxc"],
  "rules": {
    // Next/React use the automatic JSX runtime; importing React solely for JSX is obsolete.
    "react/react-in-jsx-scope": "off",
    // CSS/font imports in Next layouts are intentionally side-effect-only.
    "import/no-unassigned-import": "off",
    // The codebase uses namespace-style fast-check calls in tests for readability.
    "import/no-named-as-default-member": "off",
    // Mutating array methods are used on fresh local arrays in kernel paths.
    "unicorn/no-array-sort": "off",
    // Local helper placement is clearer next to the proof calculations it supports.
    "unicorn/consistent-function-scoping": "off",
    // Worker postMessage target origins are not applicable to dedicated worker ports.
    "unicorn/require-post-message-target-origin": "off",
    // Short algebra/proof names in tests and kernels are clearer than avoiding every shadow.
    "no-shadow": "off",
    // Existing status/img roles are intentional UI semantics; broader a11y checks stay enabled.
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "overrides": [
    {
      "files": ["src/zk/**/*.{ts,tsx,js,jsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "src/zk is a pure proof kernel and must not import React."
              },
              {
                "name": "react-dom",
                "message": "src/zk is a pure proof kernel and must not import React DOM."
              },
              {
                "name": "next",
                "message": "src/zk is a pure proof kernel and must not import Next.js."
              },
              {
                "name": "@xyflow/react",
                "message": "src/zk is a pure proof kernel and must not import React Flow."
              }
            ]
          }
        ]
      }
    }
  ]
}
